{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-xai-oauth"],
  "instructions": ["AGENTS.md", "PERSONA.md"],
  "mcp": {
    "x-search": {
      "type": "local",
      "command": ["/home/otr/Repos/x-search-mcp/x-search-mcp/start-with-oauth.sh"],
      "cwd": "x-search-mcp"
    }
  },
  "permission": {
    "chatgpt_git": "deny",
    "chatgpt_publish": "deny",
    "bash": {
      "*": "allow",
      "gh *": "ask",
      "git push": "ask",
      "git push *": "ask",
      "git -C * push": "ask",
      "git -C * push *": "ask",
      "git reset *": "ask",
      "git restore *": "ask",
      "git rebase *": "ask",
      "git commit --amend*": "ask",
      "git branch -d *": "ask",
      "rm *": "ask",
      "rmdir *": "ask",
      "ssh *": "ask",
      "scp *": "ask",
      "rsync *": "ask",
      "npm publish*": "ask",
      "pnpm publish*": "ask",
      "yarn npm publish*": "ask",
      "uv publish*": "ask",
      "twine upload*": "ask",
      "docker push*": "ask",
      "gh auth status*": "allow",
      "gh repo view*": "allow",
      "gh issue list*": "allow",
      "gh issue view*": "allow",
      "gh issue status*": "allow",
      "gh pr list*": "allow",
      "gh pr view*": "allow",
      "gh pr diff*": "allow",
      "gh pr status*": "allow",
      "gh pr checks*": "allow",
      "gh run list*": "allow",
      "gh run view*": "allow",
      "gh run watch*": "allow",
      "gh release list*": "allow",
      "gh release view*": "allow",
      "gh issue create*": "allow",
      "gh issue edit*": "allow",
      "gh issue comment*": "allow",
      "gh pr create*": "allow",
      "gh pr edit*": "allow",
      "gh pr comment*": "allow",
      "touch /run/kimaki-restart/request": "allow",
      "gh auth token*": "deny",
      "gh pr merge*": "deny",
      "git push *--force*": "deny",
      "git -C * push *--force*": "deny",
      "git reset --hard*": "deny",
      "git -C * reset --hard*": "deny",
      "git clean*": "deny",
      "git -C * clean*": "deny",
      "git checkout -- *": "deny",
      "git -C * checkout -- *": "deny",
      "git branch -D *": "deny",
      "git -C * branch -D *": "deny",
      "shred *": "deny",
      "sudo": "deny",
      "sudo *": "deny",
      "/usr/bin/sudo*": "deny",
      "/bin/sudo*": "deny",
      "su": "deny",
      "su *": "deny",
      "/usr/bin/su*": "deny",
      "/bin/su*": "deny",
      "doas*": "deny",
      "systemctl*": "deny",
      "/usr/bin/systemctl*": "deny",
      "/bin/systemctl*": "deny",
      "systemd-run*": "deny",
      "/usr/bin/systemd-run*": "deny",
      "/bin/systemd-run*": "deny",
      "busctl*": "deny",
      "/usr/bin/busctl*": "deny",
      "/bin/busctl*": "deny",
      "service*": "deny",
      "/usr/sbin/service*": "deny",
      "killall *": "deny"
    },
    "edit": {
      "*": "ask",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.env.example": "allow",
      "**/.env.config": "ask",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/id_rsa": "deny",
      "**/id_ed25519": "deny",
      "**/.git-credentials": "deny",
      "**/.netrc": "deny",
      "**/.npmrc": "deny",
      "**/.pypirc": "deny",
      "**/.git/**": "deny",
      "**/.config/gh/**": "deny",
      "**/.ssh/**": "deny",
      "**/.aws/**": "deny"
    },
    "read": {
      "*": "allow",
      "**/.env": "deny",
      "**/.env.*": "deny",
      "**/.env.example": "allow",
      "**/.env.config": "allow",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/id_rsa": "deny",
      "**/id_ed25519": "deny",
      "**/.git-credentials": "deny",
      "**/.netrc": "deny",
      "**/.npmrc": "deny",
      "**/.pypirc": "deny",
      "**/.config/gh/**": "deny",
      "**/.ssh/**": "deny",
      "**/.aws/**": "deny",
      "**/.local/share/opencode/**": "deny",
      "/home/otr/.kimaki/discord-sessions.db*": "deny"
    },
    "external_directory": {
      "*": "ask",
      "/tmp": "allow",
      "/tmp/**": "allow",
      "/run/kimaki-restart/request": "allow",
      "/mnt": "deny",
      "/mnt/**": "deny",
      "~/.config/gh/**": "deny",
      "~/.ssh/**": "deny",
      "~/.aws/**": "deny",
      "~/.local/share/opencode/**": "deny",
      "/home/otr/.kimaki/discord-sessions.db*": "deny"
    },
    "task": "ask",
    "skill": "ask",
    "lsp": "ask",
    "webfetch": "ask",
    "websearch": "ask",
    "question": "ask",
    "todowrite": "ask",
    "doom_loop": "ask"
  }
}
