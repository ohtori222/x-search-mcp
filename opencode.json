{
  "$schema": "https://opencode.ai/config.json",
  "plugin": ["opencode-xai-oauth"],
  "instructions": ["AGENTS.md", "PERSONA.md"],
  "mcp": {
    "x-search": {
      "type": "local",
      "command": ["/home/otr/Repos/x-search-mcp/x-search-mcp/start-with-oauth.sh"],
      "cwd": "x-search-mcp"
    }
  },
  "permission": {
    "*": "ask",
    "bash": {
      "*": "ask",
      "ls": "allow",
      "ls *": "allow",
      "pwd": "allow",
      "which *": "allow",
      "type *": "allow",
      "file *": "allow",
      "wc *": "allow",
      "ps": "allow",
      "ps *": "allow",
      "date": "allow",
      "uname": "allow",
      "uname *": "allow",
      "node --version": "allow",
      "npm --version": "allow",
      "pnpm --version": "allow",
      "bun --version": "allow",
      "python --version": "allow",
      "python3 --version": "allow",
      "git --version": "allow",
      "git rev-parse *": "allow",
      "git ls-files *": "allow",
      "git tag *": "allow",
      "git status": "allow",
      "git status *": "allow",
      "git diff": "allow",
      "git diff *": "allow",
      "git log": "allow",
      "git log *": "allow",
      "git branch": "allow",
      "git branch *": "allow",
      "cat *": "ask",
      "head *": "ask",
      "tail *": "ask",
      "grep *": "ask",
      "find *": "ask",
      "git show *": "ask",
      "git blame *": "ask",
      "git add *": "ask",
      "git commit *": "ask",
      "gh repo view *": "allow",
      "gh issue list *": "allow",
      "gh issue view *": "allow",
      "gh pr list *": "allow",
      "gh pr view*": "allow",
      "gh pr diff*": "allow",
      "gh pr checkout*": "ask",
      "git push *": "ask",
      "git reset --hard*": "deny",
      "git clean *": "deny",
      "git checkout -- *": "deny",
      "git restore *": "ask",
      "rm *": "ask",
      "rmdir *": "deny",
      "shred *": "deny",
      "sudo *": "deny",
      "su *": "deny",
      "doas *": "deny",
      "chmod *": "ask",
      "chown *": "deny",
      "chgrp *": "deny",
      "curl *": "ask",
      "wget *": "ask",
      "ssh *": "deny",
      "scp *": "deny",
      "rsync *": "ask",
      "env": "ask",
      "env *": "ask",
      "printenv *": "ask",
      "set": "ask",
      "python *": "ask",
      "python3 *": "ask",
      "node *": "ask",
      "bun *": "ask",
      "npx *": "ask",
      "npm *": "ask",
      "pnpm *": "ask",
      "yarn *": "ask",
      "pip *": "ask",
      "pip3 *": "ask",
      "tmux *": "ask",
      "systemctl *": "deny",
      "service *": "deny",
      "kill *": "ask",
      "pkill *": "ask",
      "killall *": "ask",
      "kimaki project list *": "allow",
      "kimaki session search *": "allow",
      "kimaki session list *": "allow",
      "kimaki session read *": "allow",
      "kimaki task list *": "allow",
      "kimaki send *": "allow"
    },
    "edit": "ask",
    "read": {
      "*": "allow",
      "/home/otr/.config/gh/**": "deny",
      "/home/otr/.local/share/opencode/**": "deny",
      "/home/otr/.config/opencode/**": "ask",
      "/home/otr/.config/opencode": "allow",
      "/home/otr/.config/opencode/opencode.json": "allow",
      "*.env": "deny",
      "*.env.*": "deny",
      "*.env.config": "ask",
      "*.env.example": "allow",
      "**/*.pem": "deny",
      "**/*.key": "deny",
      "**/id_rsa": "deny",
      "**/id_ed25519": "deny",
      "**/.git-credentials": "deny",
      "**/.netrc": "deny"
    },
    "external_directory": {
      "*": "ask",
      "/tmp": "allow",
      "/tmp/**": "allow",
      "/home/otr/.local/share/opencode/**": "deny",
      "/home/otr/.config/opencode/**": "ask",
      "/home/otr/.config/opencode": "allow",
      "/home/otr/.config/opencode/opencode.json": "allow"
    },
    "task": "ask",
    "skill": "ask",
    "lsp": "allow",
    "webfetch": "allow",
    "websearch": "allow",
    "question": "allow",
    "todowrite": "allow",
    "doom_loop": "ask"
  }
}
